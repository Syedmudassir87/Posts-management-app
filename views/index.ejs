<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>quory posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>quory posts</h1>
    <% for(let post of posts) { %>
        <div class="posts">
            <h2><%= post.username %></h2>
            <p><%= post.content %></p>
            <br>
            <br>
            <a href="http://localhost:8080/posts/<%=post.id%>">See in Details</a>
             <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit Post</a>
            <form action="/posts/<%=post.id%>/delete" method="POST">
                <button>Delete Post</button>
            </form>
        </div>
         <% } %>
    <br>
    <br>
    <a href="http://localhost:8080/posts/new">Create new posts </a>
</body>
</html>